<Window x:Class="WpfApp1345.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:WpfApp1345.Pages"
        Title="Мастер пол — информационная система"
        Icon="/WpfApp1345;component/Resources/MasterFloor.ico"
        Height="700"
        Width="1100"
        MinHeight="550"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        FontFamily="Segoe UI">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- Главная шапка с логотипом -->

        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="15,8">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Image Source="/WpfApp1345;component/Resources/MasterFloorLogo.png"
                       Width="55"
                       Height="55"
                       Stretch="Uniform"/>

                <StackPanel Margin="12,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="МАСТЕР ПОЛ"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#333333"/>

                    <TextBlock Text="Информационная система"
                               FontSize="13"
                               Foreground="#777777"/>

                </StackPanel>

            </StackPanel>

        </Border>


        <!-- Основная рабочая область -->

        <Grid Grid.Row="1"
              Margin="15">

            <TabControl x:Name="mainTabControl">


                <!-- ВКЛАДКА 1: СПИСОК ТЕЛЕФОНОВ -->

                <TabItem Header="Список телефонов">

                    <Grid Margin="10">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55*"/>
                            <ColumnDefinition Width="45*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="60"/>
                        </Grid.RowDefinitions>

                        <ListBox x:Name="mainListBox"
                                 Grid.Column="0"
                                 Grid.Row="0"
                                 Margin="5"
                                 SelectionChanged="mainListBox_SelectionChanged">

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8">

                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="{Binding CompanyEntity.Title}"/>

                                        <TextBlock Text="{Binding Price,
                                            StringFormat={}{0:N2} руб.}"/>

                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>

                        </ListBox>


                        <StackPanel Grid.Column="1"
                                    Grid.Row="0"
                                    Margin="15">

                            <TextBlock Text="Информация о телефоне"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Margin="0,0,0,20"/>

                            <TextBlock Text="Модель телефона"/>

                            <TextBox x:Name="titleView"
                                     Height="32"
                                     Margin="0,5,0,15"/>

                            <TextBlock Text="Производитель"/>

                            <ComboBox x:Name="companyView"
                                      Height="32"
                                      Margin="0,5,0,15"
                                      DisplayMemberPath="Title"
                                      SelectedValuePath="Id"/>

                            <TextBlock Text="Цена"/>

                            <TextBox x:Name="priceView"
                                     Height="32"
                                     Margin="0,5,0,15"/>

                        </StackPanel>


                        <StackPanel Grid.Column="0"
                                    Grid.Row="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Button Content="Добавить"
                                    Width="110"
                                    Height="40"
                                    Margin="5"
                                    Click="AddButton_Click"/>

                            <Button Content="Удалить"
                                    Width="110"
                                    Height="40"
                                    Margin="5"
                                    Click="RemoveButton_Click"/>

                        </StackPanel>

                    </Grid>

                </TabItem>


                <!-- ВКЛАДКА 2: ТАБЛИЦА ТЕЛЕФОНОВ -->

                <TabItem Header="Таблица телефонов">

                    <Grid Margin="10">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="60"/>
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="mainDataGridView"
                                  Grid.Row="0"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  Margin="0,0,0,10"
                                  FontSize="15"
                                  RowHeight="38"
                                  AlternatingRowBackground="#F2F2F2">

                            <DataGrid.ContextMenu>
                                <ContextMenu>

                                    <MenuItem Header="Подробнее"
                                              Click="AboutMenuItem_Click"/>

                                    <Separator/>

                                    <MenuItem Header="Редактировать"
                                              Click="EditButton_Click"/>

                                    <MenuItem Header="Удалить"
                                              Click="DeleteDataGridButton_Click"/>

                                </ContextMenu>
                            </DataGrid.ContextMenu>

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">

                                    <EventSetter Event="PreviewMouseRightButtonDown"
                                                 Handler="DataGridRow_PreviewMouseRightButtonDown"/>

                                    <EventSetter Event="MouseDoubleClick"
                                                 Handler="AboutMenuItem_Click"/>

                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>

                                <DataGridTemplateColumn Header="Действия"
                                                        Width="170">

                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>

                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center">

                                                <Button Content="Изменить"
                                                        Margin="3"
                                                        Padding="5,2"
                                                        Click="EditButton_Click"/>

                                                <Button Content="Удалить"
                                                        Margin="3"
                                                        Padding="5,2"
                                                        Click="DeleteDataGridButton_Click"/>

                                            </StackPanel>

                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Название"
                                                    Binding="{Binding Title}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Компания"
                                                    Binding="{Binding CompanyEntity.Title}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Цена"
                                                    Binding="{Binding Price,
                                                        StringFormat={}{0:N2}}"
                                                    Width="150"/>

                            </DataGrid.Columns>

                        </DataGrid>

                        <Button Grid.Row="1"
                                Content="Добавить телефон"
                                Width="170"
                                Height="40"
                                HorizontalAlignment="Left"
                                Click="OpenAddWindow_Click"/>

                    </Grid>

                </TabItem>


                <!-- ВКЛАДКА 3: СОТРУДНИКИ -->

                <TabItem Header="Сотрудники">

                    <Grid Margin="15">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="60"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0"
                                Content="Обновить список"
                                Width="450"
                                Height="42"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="15"
                                Click="RefreshListButton_Click"/>

                        <ListBox x:Name="employeeListBox"
                                 Grid.Row="1"
                                 Width="600"
                                 Margin="5,10"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Stretch"
                                 FontSize="15"
                                 HorizontalContentAlignment="Stretch">

                            <ListBox.ItemTemplate>
                                <DataTemplate>

                                    <StackPanel Margin="10"
                                                HorizontalAlignment="Center">

                                        <TextBlock Text="{Binding FullName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="16"
                                                   Margin="0,3"/>

                                        <TextBlock Text="{Binding PhoneNumber}"
                                                   Margin="0,3"/>

                                        <TextBlock Text="{Binding Email}"
                                                   Margin="0,3"
                                                   TextWrapping="Wrap"/>

                                    </StackPanel>

                                </DataTemplate>
                            </ListBox.ItemTemplate>

                        </ListBox>

                    </Grid>

                </TabItem>


                <!-- ВКЛАДКА 4: ПАРТНЁРЫ -->

                <TabItem Header="Партнёры">

                    <pages:PartnersPage/>

                </TabItem>


            </TabControl>


            <!-- Страница подробной информации о телефоне -->

            <Frame x:Name="mainFrame"
                   NavigationUIVisibility="Hidden"
                   Visibility="Collapsed"
                   Background="White"
                   Panel.ZIndex="10"/>

        </Grid>

    </Grid>

</Window>

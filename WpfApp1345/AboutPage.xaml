<Page x:Class="WpfApp1345.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Подробная информация"
      Background="White">

    <Page.Resources>

        <ControlTemplate x:Key="RoundButton"
                         TargetType="{x:Type Button}">

            <Border Width="50"
                    Height="50"
                    CornerRadius="25"
                    BorderBrush="Black"
                    BorderThickness="2"
                    Background="White">

                <ContentPresenter
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

            </Border>

        </ControlTemplate>

    </Page.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Кнопка назад -->

        <Button Grid.Row="0"
                Grid.Column="0"
                Width="50"
                Height="50"
                Template="{StaticResource RoundButton}"
                Content="←"
                FontSize="32"
                Click="BackButton_Click"
                VerticalAlignment="Top"/>

        <!-- Изображение телефона -->

        <Grid Grid.Row="0"
              Grid.Column="1"
              Width="280"
              Height="280"
              Margin="5">

            <Image x:Name="imagePageView"
                   Stretch="Uniform"/>

            <Border x:Name="noImagePanel"
                    Background="#EEEEEE"
                    CornerRadius="5">

                <TextBlock Text="NO IMAGE"
                           FontSize="23"
                           FontWeight="Bold"
                           Foreground="Gray"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

            </Border>

        </Grid>

        <!-- Информация о телефоне -->

        <StackPanel Grid.Row="0"
                    Grid.Column="2"
                    Margin="30,5,5,5">

            <TextBlock Text="Название телефона:"
                       FontSize="20"
                       Margin="0,0,0,10"/>

            <TextBlock x:Name="titlePageView"
                       FontSize="19"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,25"/>

            <TextBlock Text="Производитель:"
                       FontSize="20"
                       Margin="0,0,0,10"/>

            <TextBlock x:Name="companyPageView"
                       FontSize="19"
                       Margin="0,0,0,25"/>

            <TextBlock Text="Цена:"
                       FontSize="20"
                       Margin="0,0,0,10"/>

            <TextBlock x:Name="pricePageView"
                       FontSize="19"/>

        </StackPanel>

        <!-- Описание -->

        <StackPanel Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Margin="5,20,5,10">

            <TextBlock Text="Описание:"
                       FontSize="20"
                       Margin="0,0,0,15"/>

            <TextBlock x:Name="definitionPageView"
                       FontSize="17"
                       TextWrapping="Wrap"/>

        </StackPanel>

    </Grid>

</Page>

<Window x:Class="WpfApp1345.Windows.PartnerFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Партнёр компании"
        Height="720"
        Width="820"
        MinHeight="650"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#FFFFFF"
        FontFamily="Segoe UI">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>

        <!-- Заголовок формы -->

        <TextBlock x:Name="formTitleText"
                   Grid.Row="0"
                   Text="Данные партнёра"
                   FontSize="25"
                   FontWeight="Bold"
                   Foreground="#333333"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>


        <!-- Поля формы -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid Margin="5,10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- Левая колонка -->

                <StackPanel Grid.Column="0"
                            Grid.Row="0"
                            Margin="5,5,15,15">

                    <TextBlock Text="Наименование партнёра *"
                               FontSize="14"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="nameTextBox"
                             Height="36"
                             Padding="8"
                             FontSize="14"/>

                </StackPanel>


                <StackPanel Grid.Column="0"
                            Grid.Row="1"
                            Margin="5,5,15,15">

                    <TextBlock Text="Тип партнёра *"
                               FontSize="14"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="partnerTypeComboBox"
                              Height="36"
                              Padding="6"
                              FontSize="14"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"/>

                </StackPanel>


                <StackPanel Grid.Column="0"
                            Grid.Row="2"
                            Margin="5,5,15,15">

                    <TextBlock Text="Рейтинг *"
                               FontSize="14"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="ratingTextBox"
                             Height="36"
                             Padding="8"
                             FontSize="14"
                             ToolTip="Введите целое неотрицательное число"/>

                </StackPanel>


                <StackPanel Grid.Column="0"
                            Grid.Row="3"
                            Margin="5,5,15,15">

                    <TextBlock Text="ФИО директора *"
                               FontSize="14"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="directorTextBox"
                             Height="36"
                             Padding="8"
                             FontSize="14"/>

                </StackPanel>


                <StackPanel Grid.Column="0"
                            Grid.Row="4"
                            Margin="5,5,15,15">

                    <TextBlock Text="Телефон *"
                               FontSize="14"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="phoneTextBox"
                             Height="36"
                             Padding="8"
                             FontSize="14"/>

                </StackPanel>


                <StackPanel Grid.Column="0"
                            Grid.Row="5"
                            Margin="5,5,15,15">

                    <TextBlock Text="ИНН *"
                               FontSize="14"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="innTextBox"
                             Height="36"
                             Padding="8"
                             FontSize="14"/>

                </StackPanel>


                <!-- Правая колонка -->

                <StackPanel Grid.Column="1"
                            Grid.Row="0"
                            Margin="15,5,5,15">

                    <TextBlock Text="Email компании *"
                               FontSize="14"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="emailTextBox"
                             Height="36"
                             Padding="8"
                             FontSize="14"/>

                </StackPanel>


                <StackPanel Grid.Column="1"
                            Grid.Row="1"
                            Grid.RowSpan="3"
                            Margin="15,5,5,15">

                    <TextBlock Text="Юридический адрес *"
                               FontSize="14"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="addressTextBox"
                             Height="150"
                             Padding="8"
                             FontSize="14"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"/>

                </StackPanel>


                <!-- Подсказка -->

                <TextBlock Grid.Column="1"
                           Grid.Row="4"
                           Grid.RowSpan="2"
                           Text="* Обязательные поля. Рейтинг должен быть целым неотрицательным числом."
                           TextWrapping="Wrap"
                           Foreground="#777777"
                           FontSize="12"
                           Margin="15,5,5,15"
                           VerticalAlignment="Center"/>

            </Grid>

        </ScrollViewer>


        <!-- Кнопки -->

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <Button x:Name="saveButton"
                    Content="Сохранить"
                    Width="165"
                    Height="42"
                    Margin="5"
                    Background="#67BA80"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="14"
                    FontWeight="SemiBold"
                    IsDefault="True"
                    Click="SaveButton_Click"/>

            <Button Content="Отмена"
                    Width="125"
                    Height="42"
                    Margin="5"
                    Background="#F4E8D3"
                    Foreground="#333333"
                    BorderThickness="0"
                    FontSize="14"
                    IsCancel="True"/>

        </StackPanel>

    </Grid>

</Window>

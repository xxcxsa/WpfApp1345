<Window x:Class="WpfApp1345.Windows.MaterialCalculatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Расчёт необходимого материала"
        Height="590"
        Width="650"
        MinHeight="520"
        MinWidth="550"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFF"
        FontFamily="Segoe UI">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="105"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->

        <StackPanel Grid.Row="0">

            <TextBlock Text="Расчёт материала"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#333333"/>

            <TextBlock Text="Расчёт с учётом коэффициента продукции и брака"
                       FontSize="13"
                       Foreground="#777777"
                       Margin="0,4,0,0"/>

        </StackPanel>


        <!-- Поля расчёта -->

        <StackPanel Grid.Row="1"
                    Margin="5,15">

            <TextBlock Text="Тип продукции"
                       FontSize="14"
                       Margin="0,0,0,6"/>

            <ComboBox x:Name="productTypeComboBox"
                      Height="38"
                      Padding="7"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      Margin="0,0,0,18"/>


            <TextBlock Text="Тип материала"
                       FontSize="14"
                       Margin="0,0,0,6"/>

            <ComboBox x:Name="materialTypeComboBox"
                      Height="38"
                      Padding="7"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      Margin="0,0,0,18"/>


            <TextBlock Text="Количество изделий"
                       FontSize="14"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="quantityTextBox"
                     Height="38"
                     Padding="8"
                     Margin="0,0,0,18"/>


            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,10,0">

                    <TextBlock Text="Ширина изделия"
                               FontSize="14"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="widthTextBox"
                             Height="38"
                             Padding="8"/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="10,0,0,0">

                    <TextBlock Text="Длина изделия"
                               FontSize="14"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="lengthTextBox"
                             Height="38"
                             Padding="8"/>

                </StackPanel>

            </Grid>

        </StackPanel>


        <!-- Результат -->

        <StackPanel Grid.Row="2"
                    VerticalAlignment="Center">

            <Button Content="Рассчитать материал"
                    Height="42"
                    Background="#67BA80"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Click="CalculateButton_Click"/>

            <TextBlock x:Name="resultTextBlock"
                       Text="Результат появится после расчёта."
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#333333"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,12,0,0"/>

        </StackPanel>

    </Grid>

</Window>

<Window x:Class="WpfApp1345.Windows.AddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление телефона"
        Height="620"
        Width="800"
        MinHeight="580"
        MinWidth="700"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Добавление телефона"
                   FontSize="26"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть -->

            <StackPanel Grid.Column="0"
                        Margin="5,10,15,10">

                <TextBlock Text="Название"
                           FontSize="15"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="titleView"
                         Height="34"
                         Margin="0,0,0,18"/>

                <TextBlock Text="Компания"
                           FontSize="15"
                           Margin="0,0,0,5"/>

                <ComboBox x:Name="companyView"
                          Height="34"
                          Margin="0,0,0,18"
                          DisplayMemberPath="Title"
                          SelectedValuePath="Id"/>

                <TextBlock Text="Цена"
                           FontSize="15"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="priceView"
                         Height="34"
                         Margin="0,0,0,22"/>

                <TextBlock Text="Изображение"
                           FontSize="15"
                           Margin="0,0,0,8"/>

                <Button Content="Выбрать изображение"
                        Height="35"
                        Width="190"
                        HorizontalAlignment="Left"
                        Click="SelectImageButton_Click"/>

                <TextBlock x:Name="selectedImageView"
                           Text="Изображение не выбрано"
                           TextWrapping="Wrap"
                           Foreground="Gray"
                           Margin="0,8,0,0"/>

            </StackPanel>

            <!-- Правая часть -->

            <StackPanel Grid.Column="1"
                        Margin="15,10,5,10">

                <TextBlock Text="Описание"
                           FontSize="15"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="definitionView"
                         Height="370"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         Padding="8"/>

            </StackPanel>

        </Grid>

        <!-- Кнопки -->

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <Button Content="Добавить"
                    Width="160"
                    Height="40"
                    Margin="5"
                    Click="AddPhoneButton_Click"/>

            <Button Content="Отмена"
                    Width="120"
                    Height="40"
                    Margin="5"
                    Click="CancelButton_Click"/>

        </StackPanel>

    </Grid>

</Window>

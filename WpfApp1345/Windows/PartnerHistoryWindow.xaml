<Window x:Class="WpfApp1345.Windows.PartnerHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История продаж партнёра"
        Height="570"
        Width="950"
        MinHeight="450"
        MinWidth="750"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFF"
        FontFamily="Segoe UI">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="65"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->

        <StackPanel Grid.Row="0">

            <TextBlock x:Name="partnerNameText"
                       Text="История продаж"
                       FontSize="23"
                       FontWeight="Bold"
                       Foreground="#333333"/>

            <TextBlock Text="Реализация продукции выбранным партнёром"
                       FontSize="13"
                       Foreground="#777777"
                       Margin="0,5,0,0"/>

        </StackPanel>


        <!-- Таблица истории продаж -->

        <DataGrid x:Name="historyDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  RowHeight="38"
                  FontSize="14"
                  AlternatingRowBackground="#F4E8D3">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Наименование продукции"
                                    Binding="{Binding ProductName}"
                                    Width="*"/>

                <DataGridTextColumn Header="Количество"
                                    Binding="{Binding Quantity}"
                                    Width="140"/>

                <DataGridTextColumn Header="Дата продажи"
                                    Binding="{Binding SaleDate,
                                        StringFormat={}{0:dd.MM.yyyy}}"
                                    Width="160"/>

            </DataGrid.Columns>

        </DataGrid>


        <!-- Итоги и кнопка возврата -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center">

                <TextBlock x:Name="salesCountText"
                           FontSize="13"
                           Foreground="#555555"/>

                <TextBlock x:Name="salesQuantityText"
                           FontSize="13"
                           Foreground="#555555"
                           Margin="0,3,0,0"/>

            </StackPanel>

            <Button Grid.Column="1"
                    Content="Назад"
                    Width="130"
                    Height="40"
                    Background="#67BA80"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Click="BackButton_Click"/>

        </Grid>

    </Grid>

</Window>
